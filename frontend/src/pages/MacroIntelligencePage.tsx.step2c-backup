import {
  AlertTriangle,
  BrainCircuit,
  CheckCircle2,
  Clock3,
  ImageUp,
  Loader2,
  ShieldCheck,
  Sparkles,
  TrendingDown,
  TrendingUp,
} from "lucide-react"
import { useState } from "react"

import {
  analyzeNFPEvidence,
  type NFPTextAnalysisResponse,
} from "@/api/macroIntelligence"

const macroEvents = [
  "NFP",
  "CPI",
  "PPI",
  "FOMC",
] as const

function displayValue(
  value: number | null | undefined,
  suffix = "",
) {
  if (
    value === null ||
    value === undefined
  ) {
    return "Not detected"
  }

  return `${value}${suffix}`
}

export default function MacroIntelligencePage() {
  const [evidence, setEvidence] =
    useState("")

  const [analysis, setAnalysis] =
    useState<NFPTextAnalysisResponse | null>(
      null,
    )

  const [loading, setLoading] =
    useState(false)

  const [error, setError] =
    useState("")

  const [screenshots, setScreenshots] =
    useState<File[]>([])

  async function runAnalysis() {
    const cleanEvidence =
      evidence.trim()

    if (
      !cleanEvidence &&
      screenshots.length === 0
    ) {
      setError(
        "Paste NFP evidence, upload a screenshot, or provide both.",
      )
      return
    }

    setLoading(true)
    setError("")
    setAnalysis(null)

    try {
      const result =
        await analyzeNFPEvidence(
          cleanEvidence,
          screenshots,
        )

      setAnalysis(result)
    } catch (err: any) {
      const status =
        err?.response?.status

      if (status === 403) {
        setError(
          "Macro Intelligence requires Premium access.",
        )
      } else if (status === 413) {
        setError(
          "The screenshot is too large. Maximum size is 10 MB.",
        )
      } else if (status === 415) {
        setError(
          "Upload a PNG, JPG, JPEG or WEBP screenshot.",
        )
      } else if (status === 422) {
        setError(
          "The supplied economic evidence could not be analysed.",
        )
      } else if (status === 502) {
        setError(
          "AI evidence extraction is temporarily unavailable. Try again.",
        )
      } else {
        setError(
          "Macro analysis failed. Check that the backend and Gemini connection are running, then try again.",
        )
      }
    } finally {
      setLoading(false)
    }
  }

  const extracted =
    analysis?.extracted_evidence

  const resultClasses =
    analysis?.classification ===
    "STRONG"
      ? "border-emerald-400/25 bg-emerald-400/[0.07] text-emerald-300"
      : analysis?.classification ===
          "WEAK"
        ? "border-red-400/25 bg-red-400/[0.07] text-red-300"
        : "border-amber-400/25 bg-amber-400/[0.07] text-amber-300"

  return (
    <div className="space-y-6">
      <header>
        <div className="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.25em] text-blue-300">
          <BrainCircuit className="size-4" />
          TradePilot AI Intelligence
        </div>

        <h1 className="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">
          Macro Intelligence
        </h1>

        <p className="mt-3 max-w-3xl text-sm leading-6 text-slate-400">
          Interpret major economic releases using
          AI evidence extraction, deterministic
          scoring, contradiction detection and
          confidence analysis.
        </p>
      </header>

      <section className="premium-card rounded-3xl p-2">
        <div className="grid grid-cols-2 gap-2 md:grid-cols-4">
          {macroEvents.map(
            (event) => {
              const available =
                event === "NFP"

              return (
                <button
                  key={event}
                  type="button"
                  disabled={!available}
                  className={[
                    "rounded-2xl px-4 py-3 text-sm font-semibold transition",
                    available
                      ? "bg-blue-500 text-white"
                      : "cursor-not-allowed text-slate-600",
                  ].join(" ")}
                >
                  {event}

                  {!available && (
                    <span className="ml-2 text-[10px] uppercase">
                      Soon
                    </span>
                  )}
                </button>
              )
            },
          )}
        </div>
      </section>

      <section className="grid gap-6 xl:grid-cols-[1.05fr_.95fr]">
        <div className="premium-card rounded-[2rem] p-6">
          <div className="flex items-start justify-between gap-4">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.2em] text-blue-300">
                NFP Event Analyzer
              </p>

              <h2 className="mt-2 text-xl font-semibold text-white">
                Supply economic evidence
              </h2>
            </div>

            <Sparkles className="size-5 text-blue-300" />
          </div>

          <p className="mt-3 text-sm leading-6 text-slate-400">
            Paste NFP data or upload a screenshot
            from an economic calendar, news source
            or your own research. You can also use
            text and a screenshot together.
          </p>

          <textarea
            value={evidence}
            maxLength={50000}
            onChange={(event) =>
              setEvidence(
                event.target.value,
              )
            }
            placeholder={`Example:

US Non-Farm Payrolls

NFP Actual: 250K
Forecast: 180K
Previous: 165K
Revised Previous: 170K

Unemployment Actual: 4.0%
Forecast: 4.1%
Previous: 4.1%

Average Hourly Earnings MoM Actual: 0.4%
Forecast: 0.3%

Average Hourly Earnings YoY Actual: 4.1%
Forecast: 3.9%`}
            className="mt-5 min-h-[320px] w-full resize-y rounded-3xl border border-white/10 bg-black/20 p-5 text-sm leading-6 text-slate-200 outline-none transition placeholder:text-slate-600 focus:border-blue-400/40"
          />

          <div className="mt-4">
            <div className="mb-3 flex items-center gap-3">
              <div className="h-px flex-1 bg-white/10" />

              <span className="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500">
                Or add screenshots
              </span>

              <div className="h-px flex-1 bg-white/10" />
            </div>

            <input
              id="nfp-screenshot-upload"
              type="file"
              multiple
              accept="image/png,image/jpeg,image/webp"
              className="hidden"
              onChange={(event) => {
                const selected =
                  Array.from(
                    event.target.files ?? [],
                  )

                if (!selected.length) {
                  return
                }

                const allowed = [
                  "image/png",
                  "image/jpeg",
                  "image/webp",
                ]

                const invalid =
                  selected.find(
                    (file) =>
                      !allowed.includes(
                        file.type,
                      ),
                  )

                if (invalid) {
                  setError(
                    "Upload PNG, JPG, JPEG or WEBP screenshots only.",
                  )
                  event.target.value = ""
                  return
                }

                const oversized =
                  selected.find(
                    (file) =>
                      file.size >
                      10 * 1024 * 1024,
                  )

                if (oversized) {
                  setError(
                    "Each screenshot must be 10 MB or smaller.",
                  )
                  event.target.value = ""
                  return
                }

                setScreenshots(
                  (current) => {
                    const combined = [
                      ...current,
                    ]

                    selected.forEach(
                      (file) => {
                        const duplicate =
                          combined.some(
                            (existing) =>
                              existing.name ===
                                file.name &&
                              existing.size ===
                                file.size &&
                              existing.lastModified ===
                                file.lastModified,
                          )

                        if (
                          !duplicate &&
                          combined.length < 5
                        ) {
                          combined.push(
                            file,
                          )
                        }
                      },
                    )

                    return combined
                  },
                )

                setError("")
                event.target.value = ""
              }}
            />

            <label
              htmlFor="nfp-screenshot-upload"
              className={[
                "flex flex-col items-center justify-center rounded-3xl border border-dashed px-6 py-7 text-center transition",
                screenshots.length >= 5
                  ? "cursor-not-allowed border-white/10 bg-white/[0.02] opacity-50"
                  : "cursor-pointer border-blue-400/25 bg-blue-400/[0.04] hover:border-blue-400/50 hover:bg-blue-400/[0.07]",
              ].join(" ")}
              onClick={(event) => {
                if (
                  screenshots.length >= 5
                ) {
                  event.preventDefault()
                }
              }}
            >
              <div className="grid size-12 place-items-center rounded-2xl bg-blue-500/10 text-blue-300">
                <ImageUp className="size-6" />
              </div>

              <p className="mt-4 font-semibold text-slate-100">
                {screenshots.length >= 5
                  ? "Screenshot limit reached"
                  : "Upload Economic Screenshots"}
              </p>

              <p className="mt-1 max-w-sm text-xs leading-5 text-slate-500">
                Forex Factory, Investing.com,
                economic calendars, release
                tables or related news context.
              </p>

              <p className="mt-3 text-[10px] font-semibold uppercase tracking-[0.15em] text-slate-600">
                PNG ? JPG ? WEBP ? Max 10 MB each
              </p>

              <p className="mt-2 text-xs font-semibold text-blue-300">
                {screenshots.length} / 5 screenshots
              </p>
            </label>

            {screenshots.length > 0 ? (
              <div className="mt-3 space-y-2">
                {screenshots.map(
                  (screenshot, index) => (
                    <div
                      key={`${screenshot.name}-${screenshot.lastModified}`}
                      className="flex items-center gap-4 rounded-2xl border border-emerald-400/20 bg-emerald-400/[0.04] p-3"
                    >
                      <div className="grid size-10 shrink-0 place-items-center rounded-xl bg-emerald-400/10 text-emerald-300">
                        <ImageUp className="size-4" />
                      </div>

                      <div className="min-w-0 flex-1">
                        <p className="truncate text-sm font-semibold text-slate-100">
                          Screenshot {index + 1}
                          {" ? "}
                          {screenshot.name}
                        </p>

                        <p className="mt-1 text-xs text-slate-500">
                          {(screenshot.size / 1024 / 1024).toFixed(2)}
                          {" MB ? Ready for extraction"}
                        </p>
                      </div>

                      <button
                        type="button"
                        onClick={() =>
                          setScreenshots(
                            (current) =>
                              current.filter(
                                (_, itemIndex) =>
                                  itemIndex !==
                                  index,
                              ),
                          )
                        }
                        className="rounded-xl border border-white/10 px-3 py-2 text-xs font-semibold text-slate-400 transition hover:bg-white/[0.05] hover:text-white"
                      >
                        Remove
                      </button>
                    </div>
                  ),
                )}
              </div>
            ) : null}
          </div>

          <div className="mt-3 flex items-center justify-between text-xs text-slate-500">
            <span>
              Economic evidence only
            </span>

            <span>
              {evidence.length.toLocaleString()}
              /50,000
            </span>
          </div>

          {error ? (
            <div className="mt-4 flex gap-3 rounded-2xl border border-red-400/20 bg-red-400/[0.05] p-4 text-sm text-red-300">
              <AlertTriangle className="mt-0.5 size-4 shrink-0" />
              {error}
            </div>
          ) : null}

          <button
            type="button"
            disabled={
              loading ||
              (!evidence.trim() &&
                screenshots.length === 0)
            }
            onClick={runAnalysis}
            className="mt-5 flex w-full items-center justify-center gap-2 rounded-2xl bg-blue-500 px-5 py-3.5 font-semibold text-white transition hover:bg-blue-400 disabled:cursor-not-allowed disabled:opacity-50"
          >
            {loading ? (
              <>
                <Loader2 className="size-5 animate-spin" />
                Analysing NFP Evidence...
              </>
            ) : (
              <>
                <BrainCircuit className="size-5" />
                Analyze NFP Event
              </>
            )}
          </button>
        </div>

        <div className="premium-card rounded-[2rem] p-6">
          <p className="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">
            Intelligence Result
          </p>

          {!analysis ? (
            <div className="grid min-h-[420px] place-items-center text-center">
              <div>
                <BrainCircuit className="mx-auto size-11 text-slate-600" />

                <h3 className="mt-4 font-semibold text-slate-300">
                  Waiting for evidence
                </h3>

                <p className="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">
                  Event classification, score,
                  analysis confidence and
                  reasoning will appear here.
                </p>
              </div>
            </div>
          ) : (
            <div className="mt-5 space-y-5">
              <div
                className={`rounded-3xl border p-6 ${resultClasses}`}
              >
                <p className="text-xs font-semibold uppercase tracking-[0.2em] opacity-70">
                  Event Classification
                </p>

                <div className="mt-3 flex items-center gap-3">
                  {analysis.classification ===
                  "STRONG" ? (
                    <TrendingUp className="size-8" />
                  ) : analysis.classification ===
                    "WEAK" ? (
                    <TrendingDown className="size-8" />
                  ) : (
                    <AlertTriangle className="size-8" />
                  )}

                  <span className="text-3xl font-bold">
                    {analysis.classification}
                  </span>
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div className="rounded-2xl border border-white/[0.07] bg-white/[0.025] p-4">
                  <p className="text-xs text-slate-500">
                    Event Score
                  </p>

                  <p className="mt-2 text-2xl font-semibold text-white">
                    {analysis.score > 0
                      ? "+"
                      : ""}
                    {analysis.score}
                  </p>
                </div>

                <div className="rounded-2xl border border-white/[0.07] bg-white/[0.025] p-4">
                  <p className="text-xs text-slate-500">
                    Analysis Confidence
                  </p>

                  <p className="mt-2 text-2xl font-semibold text-white">
                    {analysis.confidence}%
                  </p>
                </div>
              </div>

              <div>
                <p className="text-sm font-semibold text-white">
                  Analysis
                </p>

                <p className="mt-2 text-sm leading-6 text-slate-400">
                  {analysis.summary}
                </p>
              </div>
            </div>
          )}
        </div>
      </section>

      {analysis?.directional_bias ? (
        <section className="premium-card rounded-[2rem] p-6">
          <div className="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.2em] text-violet-300">
                Directional Macro Bias
              </p>

              <h2 className="mt-2 text-xl font-semibold text-white">
                Market pressure interpretation
              </h2>
            </div>

            <ShieldCheck className="size-6 text-violet-300" />
          </div>

          <p className="mt-3 max-w-4xl text-sm leading-6 text-slate-400">
            {analysis.directional_bias.overall_context}
          </p>

          <div className="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            {analysis.directional_bias.markets.map(
              (item) => {
                const bullish =
                  item.bias === "BULLISH"

                const bearish =
                  item.bias === "BEARISH"

                const mixed =
                  item.bias === "MIXED"

                const biasClass =
                  bullish
                    ? "border-emerald-400/20 bg-emerald-400/[0.05] text-emerald-300"
                    : bearish
                      ? "border-red-400/20 bg-red-400/[0.05] text-red-300"
                      : mixed
                        ? "border-amber-400/20 bg-amber-400/[0.05] text-amber-300"
                        : "border-white/10 bg-white/[0.025] text-slate-300"

                return (
                  <div
                    key={item.market}
                    className={`rounded-3xl border p-5 ${biasClass}`}
                  >
                    <p className="text-xs font-semibold uppercase tracking-[0.16em] opacity-60">
                      {item.market}
                    </p>

                    <div className="mt-3 flex items-center gap-2">
                      {bullish ? (
                        <TrendingUp className="size-5" />
                      ) : bearish ? (
                        <TrendingDown className="size-5" />
                      ) : (
                        <AlertTriangle className="size-5" />
                      )}

                      <span className="text-xl font-bold">
                        {item.bias}
                      </span>
                    </div>

                    <p className="mt-3 text-xs font-semibold opacity-70">
                      Confidence: {item.confidence}%
                    </p>

                    <p className="mt-3 text-xs leading-5 text-slate-400">
                      {item.explanation}
                    </p>
                  </div>
                )
              },
            )}
          </div>

          {analysis.evidence_sources?.length ? (
            <div className="mt-6">
              <p className="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">
                Evidence Sources Used
              </p>

              <div className="mt-3 flex flex-wrap gap-2">
                {analysis.evidence_sources.map(
                  (source) => (
                    <span
                      key={source}
                      className="rounded-full border border-white/10 bg-white/[0.035] px-3 py-1.5 text-xs text-slate-300"
                    >
                      {source}
                    </span>
                  ),
                )}
              </div>
            </div>
          ) : null}

          <div className="mt-6 rounded-2xl border border-amber-400/15 bg-amber-400/[0.04] p-4">
            <p className="text-xs leading-5 text-amber-200/70">
              {analysis.directional_bias.disclaimer}
            </p>
          </div>
        </section>
      ) : null}

      {analysis && extracted ? (
        <>
          <section className="premium-card rounded-[2rem] p-6">
            <p className="text-xs font-semibold uppercase tracking-[0.2em] text-blue-300">
              Extracted Economic Data
            </p>

            <h2 className="mt-2 text-xl font-semibold text-white">
              Evidence detected by AI
            </h2>

            <div className="mt-5 overflow-x-auto">
              <table className="w-full min-w-[720px] text-sm">
                <thead>
                  <tr className="text-left text-slate-500">
                    <th className="px-4 py-3">
                      Indicator
                    </th>

                    <th className="px-4 py-3">
                      Actual
                    </th>

                    <th className="px-4 py-3">
                      Forecast
                    </th>

                    <th className="px-4 py-3">
                      Previous
                    </th>
                  </tr>
                </thead>

                <tbody>
                  <tr className="border-t border-white/[0.06]">
                    <td className="px-4 py-4 text-white">
                      Non-Farm Payrolls
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.nfp_actual,
                        "K",
                      )}
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.nfp_forecast,
                        "K",
                      )}
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.nfp_previous,
                        "K",
                      )}
                    </td>
                  </tr>

                  <tr className="border-t border-white/[0.06]">
                    <td className="px-4 py-4 text-white">
                      Unemployment Rate
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.unemployment_actual,
                        "%",
                      )}
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.unemployment_forecast,
                        "%",
                      )}
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.unemployment_previous,
                        "%",
                      )}
                    </td>
                  </tr>

                  <tr className="border-t border-white/[0.06]">
                    <td className="px-4 py-4 text-white">
                      Average Hourly Earnings MoM
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.wage_mom_actual,
                        "%",
                      )}
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.wage_mom_forecast,
                        "%",
                      )}
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.wage_mom_previous,
                        "%",
                      )}
                    </td>
                  </tr>

                  <tr className="border-t border-white/[0.06]">
                    <td className="px-4 py-4 text-white">
                      Average Hourly Earnings YoY
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.wage_yoy_actual,
                        "%",
                      )}
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.wage_yoy_forecast,
                        "%",
                      )}
                    </td>

                    <td className="px-4 py-4">
                      {displayValue(
                        extracted.wage_yoy_previous,
                        "%",
                      )}
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            {extracted.nfp_revised_previous !==
            null ? (
              <div className="mt-4 rounded-2xl border border-white/[0.07] bg-white/[0.025] p-4 text-sm">
                <span className="text-slate-500">
                  Revised Previous NFP:
                </span>{" "}
                <span className="font-semibold text-white">
                  {
                    extracted.nfp_revised_previous
                  }
                  K
                </span>
              </div>
            ) : null}
          </section>

          <section className="grid gap-5 lg:grid-cols-2">
            <div className="premium-card rounded-3xl p-6">
              <div className="flex items-center gap-2">
                <TrendingUp className="size-5 text-emerald-300" />

                <h3 className="font-semibold text-white">
                  Strong Factors
                </h3>
              </div>

              <div className="mt-4 space-y-3">
                {analysis.strong_factors.length >
                0 ? (
                  analysis.strong_factors.map(
                    (factor) => (
                      <div
                        key={factor}
                        className="flex gap-3 text-sm leading-6 text-slate-400"
                      >
                        <CheckCircle2 className="mt-1 size-4 shrink-0 text-emerald-300" />
                        <span>
                          {factor}
                        </span>
                      </div>
                    ),
                  )
                ) : (
                  <p className="text-sm text-slate-500">
                    No strong factors detected.
                  </p>
                )}
              </div>
            </div>

            <div className="premium-card rounded-3xl p-6">
              <div className="flex items-center gap-2">
                <TrendingDown className="size-5 text-red-300" />

                <h3 className="font-semibold text-white">
                  Weak Factors
                </h3>
              </div>

              <div className="mt-4 space-y-3">
                {analysis.weak_factors.length >
                0 ? (
                  analysis.weak_factors.map(
                    (factor) => (
                      <div
                        key={factor}
                        className="flex gap-3 text-sm leading-6 text-slate-400"
                      >
                        <AlertTriangle className="mt-1 size-4 shrink-0 text-red-300" />
                        <span>
                          {factor}
                        </span>
                      </div>
                    ),
                  )
                ) : (
                  <p className="text-sm text-slate-500">
                    No weak factors detected.
                  </p>
                )}
              </div>
            </div>
          </section>

          {(analysis.contradictions.length >
            0 ||
            analysis.warnings.length >
              0) && (
            <section className="premium-card rounded-3xl p-6">
              <div className="flex items-center gap-2">
                <AlertTriangle className="size-5 text-amber-300" />

                <h3 className="font-semibold text-white">
                  Contradictions & Warnings
                </h3>
              </div>

              <div className="mt-4 space-y-3">
                {[
                  ...analysis.contradictions,
                  ...analysis.warnings,
                ].map((item) => (
                  <div
                    key={item}
                    className="rounded-2xl border border-amber-400/10 bg-amber-400/[0.03] p-4 text-sm leading-6 text-slate-400"
                  >
                    {item}
                  </div>
                ))}
              </div>
            </section>
          )}

          {extracted.uncertainties.length >
          0 ? (
            <section className="premium-card rounded-3xl p-6">
              <h3 className="font-semibold text-white">
                Extraction Uncertainties
              </h3>

              <div className="mt-4 space-y-2 text-sm text-slate-400">
                {extracted.uncertainties.map(
                  (item) => (
                    <p key={item}>
                      {item}
                    </p>
                  ),
                )}
              </div>
            </section>
          ) : null}

          <section className="rounded-3xl border border-blue-400/15 bg-blue-400/[0.04] p-5">
            <div className="flex gap-3">
              <ShieldCheck className="mt-0.5 size-5 shrink-0 text-blue-300" />

              <div>
                <p className="text-sm font-medium text-slate-300">
                  Economic interpretation only
                </p>

                <p className="mt-1 text-xs leading-5 text-slate-500">
                  {analysis.disclaimer}
                </p>
              </div>
            </div>
          </section>
        </>
      ) : null}

      <section>
        <div className="mb-4">
          <h2 className="text-lg font-semibold text-white">
            More Macro Engines
          </h2>

          <p className="mt-1 text-sm text-slate-500">
            Additional event-specific analysis
            engines are being added.
          </p>
        </div>

        <div className="grid gap-4 md:grid-cols-3">
          {["CPI", "PPI", "FOMC"].map(
            (event) => (
              <div
                key={event}
                className="premium-card rounded-3xl p-5 opacity-70"
              >
                <Clock3 className="size-5 text-slate-500" />

                <h3 className="mt-4 font-semibold text-white">
                  {event} Analyzer
                </h3>

                <p className="mt-2 text-sm text-slate-500">
                  Coming soon to Macro
                  Intelligence.
                </p>
              </div>
            ),
          )}
        </div>
      </section>
    </div>
  )
}